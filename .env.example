# HMAC key: Read works for monitoring; Spot Trade permission enables trading.
# Withdrawal, Futures, Margin and transfer endpoints are never used by this app.
BINANCE_API_KEY=
BINANCE_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Create using: python -m rice_reborn.main --set-password
RICE_PASSWORD_HASH=
# Development binds loopback. Linux systemd binds 0.0.0.0:8080.
RICE_HOST=127.0.0.1
RICE_PORT=8080
RICE_HOME=.
# Optional app-level IP allowlist in addition to the VPS firewall.
RICE_ALLOWED_IPS=
# direct: firewall whitelist + HTTP; ssh: loopback + SSH tunnel; https: loopback behind TLS proxy.
RICE_ACCESS_MODE=direct
# Set 1 only for an HTTPS browser URL. SSH tunnel uses local HTTP, keep 0.
RICE_COOKIE_SECURE=0
